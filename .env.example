AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=llama3.2:3b
AGENT_API_KEY=ollama
AGENT_MAX_STEPS=10

# Forward the GPU model's actual listening port to local port 11435.
REDTEAM_BASE_URL=http://localhost:11435/v1
