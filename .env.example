REDTEAM_API_KEY=ollama
REDTEAM_ROUNDS=6
REDTEAM_DISABLE_THINKING=true
REDTEAM_TRANSPORT=ollama_raw

TICKETS_PATH=tickets.json

DATABASE_URL=sqlite+aiosqlite:///./riposte.db

JWT_SECRET=please-generate-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_MINUTES=10080

CORS_ORIGINS=http://localhost:3000
